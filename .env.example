# Скопируйте в .env и при необходимости поправьте; .env в git не попадает.
# Каждый ключ — один раз. Имена как на платформе: там значения задаёт сама платформа.
DATA_DIR=data

# --- Docker: Ollama на хосте ---
# Внутри контейнера localhost — это сам контейнер
# Для Ollama на хосте используйте host.docker.internal:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# DEV_EMBED_BASE_URL=http://host.docker.internal:11434/v1
# DEV_RERANK_BASE_URL=http://host.docker.internal:11434/v1
# На хосте Ollama должна слушать 0.0.0.0:11434
# иначе из контейнера до неё не достучаться

# ---- Модели ----
# Ниже — локальная Ollama. Для DeepSeek или другого OpenAI-совместимого API
# замените LLM_BASE_URL, LLM_API_KEY и LLM_MODEL на его адрес, ключ и модель.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
# На платформе: baai/bge-m3
EMB_MODEL=bge-m3
# В Ollama реранкера нет: пусто — поиск работает без него
RERANKER_MODEL=
# Необязательно: отдельные ключи эмбеддера и реранкера (иначе используется LLM_API_KEY)
EMBEDDER_API_KEY=
RERANKER_API_KEY=

# ---- Параметры ----
TOP_K=8
TEMPERATURE=0
# У qwen3 рассуждения входят в лимит токенов ответа, поэтому 2048, а не 1024
MAX_TOKENS=2048
# Локально 1: параллельные запросы к одной видеокарте не ускоряют, а перегружают её
MAX_WORKERS=1
# Секунд на один запрос к LLM; локальная модель на длинном промпте отвечает дольше 90 с
LLM_TIMEOUT=300
# Общий бюджет времени прогона, секунд (лимит платформы — 20 минут)
TIME_BUDGET_SEC=900

# ---- Только для разработки (на платформе пустые) ----
# Эмбеддер / реранкер на другом адресе, чем LLM
DEV_EMBED_BASE_URL=
DEV_RERANK_BASE_URL=
# Доп. поля запроса /chat/completions в JSON. Для qwen3 оставить пустым:
# с {"reasoning_effort": "none"} рассуждения попадают в текст ответа.
LLM_EXTRA_BODY=

# Контекст Ollama по умолчанию 4096 токенов — мало для наших промптов (до ~5500).
# Один раз перед работой: setx OLLAMA_CONTEXT_LENGTH 8192, затем перезапустить Ollama.
