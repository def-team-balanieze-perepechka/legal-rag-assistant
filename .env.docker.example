# Окружение для запуска в Docker
# Скопируйте в .env: 
#   Linux: cp .env.docker.example .env
#   Windows: copy .env.docker.example .env
# Локальная модель на хосте доступна по имени:
# host.docker.internal (см. extra_hosts в compose.yaml).

# ---- Ollama на хосте (по умолчанию) ----
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
EMB_MODEL=bge-m3
RERANKER_MODEL=

DEV_EMBED_BASE_URL=http://host.docker.internal:11434/v1
DEV_RERANK_BASE_URL=http://host.docker.internal:11434/v1

# ---- Параметры ----
TOP_K=8
TEMPERATURE=0
MAX_TOKENS=2048
MAX_WORKERS=1
LLM_TIMEOUT=300
TIME_BUDGET_SEC=900
LLM_EXTRA_BODY=

# ---- Внешний OpenAI-совместимый API (закомментировано) ----
# На платформе: DeepSeek V4.1 Flash (LLM), BAAI/bge-m3 (эмбеддинги),
# Qwen3 Reranker 8B (реранкер, необязателен). Ключи в репозиторий не кладём.
#
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4.1-flash
# EMB_MODEL=BAAI/bge-m3
# RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
# DEV_EMBED_BASE_URL=
# DEV_RERANK_BASE_URL=